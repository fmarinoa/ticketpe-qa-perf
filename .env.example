# Copiar a .env (no versionar). Todas las variables son opcionales salvo TEAM y TEAM_TOKEN.
BASE_URL=https://testathon.testingperu.com
# OBLIGATORIO para TC-PERF-01/02, sin fallback: rama del equipo, prefijo de las cuentas creadas (perf-<TEAM>-…).
TEAM=
# OBLIGATORIO para TC-PERF-04…07 (agente), sin fallback: token de espacio PROPIO del equipo. Pedir por el WhatsApp oficial.
TEAM_TOKEN=
# TC-PERF-07: off = IA real, 70 mensajes en 1 min (gasta cuota). Por defecto réplica.
REPLAY=on
