# Copiar a .env (no versionar). Todas las variables son opcionales salvo donde se indica.
BASE_URL=https://testathon.testingperu.com
TEAM=testitans
# Token de espacio PROPIO del equipo: requerido por TC-PERF-03/04 (saturan el espacio). Pedir por el WhatsApp oficial.
TEAM_TOKEN=
# Token de otro espacio para medir aislamiento de cuota del agente en TC-PERF-04 (opcional)
OTRO_TEAM_TOKEN=
# TC-PERF-03: off = IA real (gasta cuota). Por defecto réplica.
REPLAY=on
